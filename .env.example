# OpenRouter-compatible setup. The integration remains disabled until MODEL is set.
# Create your own key and choose a model ID in the OpenRouter dashboard.
FORMA_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
FORMA_LLM_MODEL=

# Required by OpenRouter. Never commit a real value.
# May stay empty only when using a keyless local OpenAI-compatible endpoint.
FORMA_LLM_API_KEY=
FORMA_LLM_TIMEOUT_MS=20000
